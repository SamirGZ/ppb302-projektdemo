<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Flytta till Kosteröarna – upptäck livet på Sveriges västligaste skärgård." />
    <title>@ViewData["Title"] - Flyttatillkoster.se</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-line">Flytta till</span>
                <span class="logo-name">Koster</span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Öppna meny">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="main-nav" id="main-nav" aria-label="Huvudmeny">
                <div class="nav-group nav-group--center">
                    <a asp-controller="Home" asp-action="PraktiskaLivet">Praktiska Livet</a>
                    <a asp-controller="Home" asp-action="Barnomsorg">Barnomsorg</a>
                    <a asp-controller="Home" asp-action="Boende">Boende</a>
                    <a asp-controller="Home" asp-action="Gemenskapen">Gemenskapen</a>
                </div>
                <div class="nav-group nav-group--right">
                    <a asp-controller="Home" asp-action="Index" asp-fragment="om-oss">Om oss</a>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="kontakt">Kontakt</a>
                </div>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <nav class="footer-nav" aria-label="Sidfotslänkar">
                <a href="#johans-berattelse">Personliga berättelser</a>
                <a href="#barnomsorg">Barnomsorg</a>
                <a href="#praktiska-livet">Praktiska livet</a>
                <a href="#boende">Boende</a>
                <a href="#gemenskapen">Gemenskapen</a>
            </nav>
            <p class="footer-tagline">
                Kosteröarna är mer än en plats – det är ett sätt att leva. Här möts människor och historier
                på en ö med släta klippor och salt vatten.
            </p>
            <a class="logo logo--footer" asp-controller="Home" asp-action="Index">
                <span class="logo-line">Flytta till</span>
                <span class="logo-name">Koster</span>
            </a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
