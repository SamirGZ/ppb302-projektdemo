@{
    ViewData["Title"] = "Kosteröarna";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg">
        <img src="~/images/hero-koster.png" alt="Kustlandskap med klippor, strand och hav vid Kosteröarna" asp-append-version="true" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-content">
        <h1 id="hero-title">Kosteröarna</h1>
        <p>
            Kosteröarna är mer än en plats – det är ett sätt att leva. Här möts människor och historier
            på en ö med släta klippor och salt vatten.
        </p>
    </div>
</section>

<section class="features" aria-label="Utforska Kosteröarna">
    <div class="features-grid">
        <article class="feature-card" id="barnomsorg">
            <div class="feature-image">
                <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=400&h=400&q=80"
                     alt="Solnedgång över kustlandskap" width="400" height="400" loading="lazy" />
            </div>
            <h2>Barnomsorg</h2>
            <p>Trygg omsorg och skola för familjer som vill rota sig på öarna.</p>
        </article>

        <article class="feature-card" id="boende">
            <div class="feature-image">
                <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=400&h=400&q=80"
                     alt="Människor som vandrar i skogen" width="400" height="400" loading="lazy" />
            </div>
            <h2>Boende</h2>
            <p>Hitta ett hem nära havet – från sommarstuga till boende året runt.</p>
        </article>

        <article class="feature-card" id="praktiska-livet">
            <div class="feature-image">
                <img src="https://images.unsplash.com/photo-1501854140801-50d01698950b?auto=format&fit=crop&w=400&h=400&q=80"
                     alt="Ljus som faller genom träd" width="400" height="400" loading="lazy" />
            </div>
            <h2>Praktiska Livet</h2>
            <p>Färja, service och vardagslogistik som fungerar i skärgården.</p>
        </article>

        <article class="feature-card" id="gemenskapen">
            <div class="feature-image">
                <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=400&h=400&q=80"
                     alt="Händer som rör vid en trädstam" width="400" height="400" loading="lazy" />
            </div>
            <h2>Gemenskapen</h2>
            <p>Engagerade öbor, föreningar och ett nätverk som håller öarna levande.</p>
        </article>
    </div>
</section>

<section class="info-strip" id="om-oss" aria-labelledby="om-oss-title">
    <div class="info-strip-inner">
        <h2 id="om-oss-title">Om oss</h2>
        <p>
            Flyttatillkoster.se samlar information och inspiration för dig som funderar på att flytta
            till Kosteröarna – Sveriges västligaste bebodda skärgård.
        </p>
    </div>
</section>

<section class="info-strip info-strip--contact" id="kontakt" aria-labelledby="kontakt-title">
    <div class="info-strip-inner">
        <h2 id="kontakt-title">Kontakt</h2>
        <p>Hör av dig om du vill veta mer om livet, boendet och möjligheterna på öarna.</p>
        <a class="contact-link" href="mailto:info@flyttatillkoster.se">info@flyttatillkoster.se</a>
    </div>
</section>
